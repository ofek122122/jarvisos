# JarvisOS Ralph autonomous build loop — systemd USER service.
#
# Install (imperative, dev tooling — deliberately NOT in the OS flake, which
# would run an AI loop at every boot forever):
#   mkdir -p ~/.config/systemd/user
#   ln -sf ~/jarvisos/ops/ralph/ralph-loop.service ~/.config/systemd/user/ralph-loop.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now ralph-loop.service
#   loginctl enable-linger "$USER"     # keep running while logged out / after reboot
#
# No arming step: the loop is a headless bash while-loop (see loop-run.sh); it
# starts building immediately.  Watch:  journalctl --user -u ralph-loop -f
# Pause: touch ~/jarvisos-ralph/.ralph-STOP    Stop: systemctl --user stop ralph-loop

[Unit]
Description=JarvisOS Ralph autonomous build loop (headless claude -p on branch ralph/auto)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/jarvisos/ops/ralph/loop-run.sh
Restart=on-failure
RestartSec=15
# Never grant this unit privilege — build needs no root, and it must never switch.

[Install]
WantedBy=default.target
