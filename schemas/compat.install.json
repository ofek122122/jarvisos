{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jarvis:schema/compat.install/v1",
  "title": "compat.install body v1",
  "description": "Windows-app install lifecycle. Publisher: jv-compat. One frame per stage; 'blocked' carries the guard's reasons via the linked guard.verdict. Envelope conf = 1.0.",
  "type": "object",
  "required": ["event", "app", "sha256"],
  "additionalProperties": false,
  "properties": {
    "event": {
      "type": "string",
      "enum": ["fingerprinted", "screened", "prefix_created", "installed", "failed", "blocked"]
    },
    "app": {
      "type": "string",
      "description": "App slug (prefix directory name), e.g. 'notepad-plus-plus'."
    },
    "sha256": {
      "type": "string",
      "description": "Installer hash — joins this lifecycle to its guard.verdict."
    },
    "path": {
      "type": "string",
      "description": "Installer path as given by the user."
    },
    "installer": {
      "type": "string",
      "enum": ["nsis", "inno", "msi", "unknown"],
      "description": "Detected installer framework (fingerprinted+)."
    },
    "arch": {
      "type": "string",
      "enum": ["x86", "x64", "arm64", "unknown"]
    },
    "recipe": {
      "type": "string",
      "description": "recipes/ entry used, if one matched."
    },
    "error": {
      "type": "string",
      "description": "failed/blocked detail."
    }
  }
}
